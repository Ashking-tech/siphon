{
  "name": "siphon-product-gif",
  "version": "1.0.0",
  "private": true,
  "description": "Siphon — a 13.6-second website product animation: Dolphin to in-place relocation.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts SiphonProductGif out/preview/frames --frame=180",
    "render": "remotion render src/index.ts SiphonProductGif out/siphon-product-master.mp4 --crf=14 --concurrency=4",
    "build": "npm run typecheck && npm run render"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
